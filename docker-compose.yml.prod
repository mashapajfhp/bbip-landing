services:
  app:
    # Set APP_IMAGE to the immutable image reference passed to the deploy script.
    image: ${APP_IMAGE:?APP_IMAGE must be an immutable registry image reference}
    container_name: bbipsystem_app

    restart: unless-stopped

    working_dir: /var/www/html

    ports:
      - "127.0.0.1:8088:80"

    env_file:
      - ../.env

    volumes:
      - ../google-serviceaccount.json:/var/www/html/storage/app/google/service-account.json

    networks:
      - bbipsystem-network

    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost/up"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 40s

networks:
  bbipsystem-network:
    driver: bridge
