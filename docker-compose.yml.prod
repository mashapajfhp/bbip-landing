version: '3.8'

services:
  app:
    build:
      context: .
      dockerfile: Dockerfile
    container_name: bbip-landing
    restart: unless-stopped
    working_dir: /var/www/html
    env_file: ../.env
    environment:
      CACHE_DRIVER: array
      QUEUE_CONNECTION: sync
    ports:
      - "8088:80"
    volumes:
      - ./storage:/var/www/html/storage
      - ./bootstrap/cache:/var/www/html/bootstrap/cache
    networks:
      - bbip-network

networks:
  bbip-network:
    driver: bridge
