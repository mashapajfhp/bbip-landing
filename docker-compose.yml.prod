version: '3.8'

services:
  app:
    build:
      context: .
      dockerfile: Dockerfile
    container_name: bbip-landing
    restart: unless-stopped
    working_dir: /var/www/html
    environment:
      APP_NAME: "BBIP Landing"
      APP_ENV: production
      APP_KEY: ${APP_KEY:-base64:WYb+qKmUsSMTNGx0lQZUQMl2O0oV/L8NN5240CoHr08=}
      APP_DEBUG: "false"
      APP_URL: http://localhost
      CACHE_DRIVER: array
      QUEUE_CONNECTION: sync
    ports:
      - "8088:80"
    volumes:
      - ./storage:/var/www/html/storage
      - ./bootstrap/cache:/var/www/html/bootstrap/cache
    networks:
      - bbip-network

networks:
  bbip-network:
    driver: bridge
